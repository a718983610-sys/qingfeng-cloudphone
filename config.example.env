# Copy to config.env and edit before running deploy_redroid.sh
ANDROID_VERSION=13.0.0
SCREEN_WIDTH=1080
SCREEN_HEIGHT=2400
SCREEN_DPI=420
DEVICE_MODEL=Pixel 8 Pro
DEVICE_DEVICE=husky
DATA_DIR=$HOME/redroid-data
# Keep ADB bound to localhost; reach it through an SSH tunnel or Tailscale.
ADB_BIND=127.0.0.1
